# CV pool (EXAMPLE). `applybot init` copies this to cvs/cvs.yaml (git-ignored).
# Put your CV file (PDF) in this folder as cvs/my-cv.pdf, or change `file` below.
#
# A job family is mapped to exactly one CV. Families with NO entry below are
# sent to human review with reason "no CV mapped", they are never guessed.
# Family names must match config/profile.yaml (families.primary / secondary /
# selective). A family may only appear under one CV.
#
# Start with one CV for everything. Later, add a CV per kind of role (for
# example a Flutter CV, a DevOps CV) and move those families under it.

cvs:
  - id: general
    file: my-cv.pdf
    families:
      - Senior Backend Engineer
      - Senior Software Engineer
      - Senior Systems Engineer
      - Solutions Architect
      - Cloud Architect
      - Platform Engineer
      - Platform Architect
      - Technical Lead
      - Distributed Systems Engineer
      - Infrastructure Engineer
      - DevOps Engineer
      - DevOps Architect
      - Cloud Infrastructure Engineer
      - Integration Architect
      - Full-Stack Developer
      - Flutter Engineer
      - Mobile Architect
      - Software Development Lead
      - Scrum Master
      - Agile Delivery Lead
      - Technical Delivery Manager
      - Engineering Manager
      - Project Manager
      - Agile Coach
      - AI Engineer
      - AI Platform Engineer
      - Principal Engineer
      - Principal Architect
